    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst { eventi, giornataBloccata } = $('Prepara punti').first().json;\n\nlet risposta = $input.first().json;\nif (typeof risposta.data === 'string') risposta = JSON.parse(risposta.data); // stesso caso del Tragitto\nconst durate = risposta.durations; // secondi: durate[da][a]\n\nconst zona = 'Europe/Rome';\nconst giorno = DateTime.fromISO(cfg.query.data, { zone: zona });\nconst alle = (hhmm) => {\n  const [h, m] = hhmm.split(':').map(Number);\n  return giorno.set({ hour: h, minute: m, second: 0, millisecond: 0 });\n};\nconst viaggio = (da, a) => {\n  const s = durate?.[da]?.[a];\n  return s == null ? Infinity : Math.ceil(s / 60); // minuti; null = non raggiungibile\n};\n\nif (giornataBloccata) {\n  return [{ json: { data: cfg.query.data, slot: [] } }];\n}\n\nconst durata = Number(cfg.durata_min);\nconst margine = Number(cfg.margine_min);\nconst passo = Number(cfg.passo_min);\nconst preavviso = Number(cfg.preavviso_min ?? 120);\nconst apertura = alle(cfg.ora_apertura);\nconst chiusura = alle(cfg.ora_chiusura);\nconst primoOrario = DateTime.now().setZone(zona).plus({ minutes: preavviso });\n\n// Blocchi occupati: appuntamenti + pausa (la pausa non ha posizione → nessun tragitto)\nconst blocchi = eventi.map(e => ({\n  inizio: DateTime.fromISO(e.inizio, { zone: zona }),\n  fine: DateTime.fromISO(e.fine, { zone: zona }),\n  idx: e.idx,\n}));\nblocchi.push({ inizio: alle(cfg.pausa_inizio), fine: alle(cfg.pausa_fine), idx: null });\n\nconst slot = [];\nfor (let t = apertura; t.plus({ minutes: durata }) <= chiusura; t = t.plus({ minutes: passo })) {\n  const fine = t.plus({ minutes: durata });\n  if (t < primoOrario) continue;\n\n  const ok = blocchi.every(b => {\n    if (t < b.fine && fine > b.inizio) return false;   // si sovrappone a un blocco\n    if (b.idx === null) return true;                     // pausa: basta non sovrapporsi\n    if (b.fine <= t)                                     // blocco prima: arriva in tempo dal cliente nuovo?\n      return b.fine.plus({ minutes: viaggio(b.idx, 0) + margine }) <= t;\n    return fine.plus({ minutes: viaggio(0, b.idx) + margine }) <= b.inizio; // blocco dopo: arriva in tempo al successivo?\n  });\n\n  if (ok) slot.push({ inizio: t.toFormat('HH:mm'), fine: fine.toFormat('HH:mm') });\n}\n\nreturn [{ json: { data: cfg.query.data, slot } }];"
      },
