    {
      "parameters": {
        "jsCode": "// Raccoglie gli eventi del giorno e prepara la lista dei punti per la matrice\nconst cfg = $('Config').first().json;\nconst cliente = $('Geocoding').first().json.features[0].geometry.coordinates; // [lon, lat]\nconst base = [Number(cfg.base_lon), Number(cfg.base_lat)];\n\nconst locations = [cliente, base]; // indice 0 = nuovo cliente, 1 = base del barbiere\nconst eventi = [];\nlet giornataBloccata = false;\n\nfor (const item of $input.all()) {\n  const ev = item.json;\n  if (!ev.start) continue;                      // item vuoto (giorno senza eventi)\n  if (ev.start.date && !ev.start.dateTime) {    // evento \"tutto il giorno\" (es. ferie)\n    giornataBloccata = true;\n    continue;\n  }\n  let idx = 1;                                  // senza coordinate → consideriamo la base\n  const m = (ev.description || '').match(/coords:\\s*(-?[\\d.]+)\\s*,\\s*(-?[\\d.]+)/);\n  if (m) {\n    locations.push([parseFloat(m[1]), parseFloat(m[2])]);\n    idx = locations.length - 1;\n  }\n  eventi.push({ titolo: ev.summary || '', inizio: ev.start.dateTime, fine: ev.end.dateTime, idx });\n}\n\nreturn [{ json: { locations, eventi, giornataBloccata } }];"
      },
